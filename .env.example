# Runtime mode: sqlite for local development, postgres for pgvector-backed search.
DB_TYPE=sqlite
DATABASE_URL=file:./dev.db

# Redis is used by BullMQ background workers.
REDIS_URL=redis://localhost:6379

# Replace both values with long, random secrets before running outside tests.
JWT_SECRET=replace_with_a_long_random_jwt_secret
ENCRYPTION_SECRET=replace_with_a_long_random_encryption_secret_at_least_32_chars

# Model credentials are configured by the user in the application (BYOK).
